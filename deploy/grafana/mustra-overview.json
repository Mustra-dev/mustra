            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(mustra_agents{online=\"false\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
